  <thead>
    <tr>
      <th scope="col">Text</th>
      <th scope="col">Viewport</th>
      <th scope="col">Font size</th>
      <th scope="col">Line height</th>
    </tr>
  </thead>
  <tbody>
    <tr><th scope="row">Body</th><td>All</td><td>1.25rem (20px)</td><td>2rem (32px)</td></tr>
    <tr><th scope="row">H1</th><td>Mobile</td><td>2.75rem (44px)</td><td>3.5rem (56px)</td></tr>
    <tr><th scope="row">H1</th><td>Desktop</td><td>3.75rem (60px)</td><td>4.75rem (76px)</td></tr>
    <tr><th scope="row">H2</th><td>Mobile</td><td>2.25rem (36px)</td><td>2.75rem (44px)</td></tr>
    <tr><th scope="row">H2</th><td>Desktop</td><td>2.5rem (40px)</td><td>3.25rem (52px)</td></tr>
    <tr><th scope="row">H3</th><td>Mobile</td><td>1.75rem (28px)</td><td>2.25rem (36px)</td></tr>
