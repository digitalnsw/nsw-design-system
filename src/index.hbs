        <div class="nsw-section nsw-section--brand-light nsw-p-x-md nsw-docs__element">
          <div class="nsw-content-block">
            <div class="nsw-content-block__pictogram" aria-hidden="true">
              <img src="/assets/images/pictogram-about.svg" alt="">
            </div>
            <div class="nsw-content-block__content">
              <h3 class="nsw-content-block__title">About</h3>
              <p class="nsw-content-block__copy">Who, what and how of the NSW Design System.</p>
