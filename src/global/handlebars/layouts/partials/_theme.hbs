<header class="nsw-header nsw-color-swatches-header">
  <div class="nsw-header__container">
    <div class="nsw-header__inner nsw-color-swatches-header__inner">
      <a class="nsw-link nsw-link--icon nsw-color-swatches-header__back" href="{{change-extention path 'index'}}">
        <span class="material-icons nsw-material-icons" focusable="false" aria-hidden="true">west</span>
        <span>Back</span>
      </a>
      <div class="nsw-color-swatches js-color-swatches"{{#if legendKey}} data-legend-key="{{legendKey}}"{{/if}}{{#if swatchKey}} data-swatch-key="{{swatchKey}}"{{/if}}>
        <legend class="nsw-color-swatches__legend" aria-live="polite" aria-atomic="true"><span class="nsw-color-swatches__color js-color-swatches__color">Blue 01</span></legend>
        {{!-- <select class="js-color-swatches__select" aria-label="Select a color"></select> --}}
      </div>
    </div>
  </div>
</header>

{{> @partial-block }}

<script src="/docs/js/docs.js"></script>
