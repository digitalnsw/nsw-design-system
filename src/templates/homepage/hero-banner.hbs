{{>_masthead content="#content" nav="#main-nav"}}
{{>_header header-title="NSW Design System" header-description="Department of Customer Service"}}
{{>_main-nav model.nav}}

{{>_hero-banner
  wide=true
  theme="dark"
  heading="Helping you deliver great government services"
  copy="Find the building blocks for creating user-centred digital services, as well as policy, tools and guidance"
  cta="View Toolkit"
}}

<main id="content">
  <section class="nsw-section">
    <div class="nsw-container">
      <div class="nsw-layout">
        <div class="nsw-layout__main">
          <h2 class="nsw-section-title">Fast track to</h2>
          <div class="nsw-grid">
            <div class="nsw-col nsw-col-md-6 nsw-col-lg-3">
              {{>_card
                highlight=true
                heading="Digital styles"
              }}
            </div>
            <div class="nsw-col nsw-col-md-6 nsw-col-lg-3">
              {{>_card
                highlight=true
                heading="Component library"
              }}
            </div>
            <div class="nsw-col nsw-col-md-6 nsw-col-lg-3">
              {{>_card
                highlight=true
                heading="Solutions marketplace"
              }}
            </div>
            <div class="nsw-col nsw-col-md-6 nsw-col-lg-3">
              {{>_card
                highlight=true
                heading="Community"
              }}
            </div>
          </div>

          <hr class="nsw-section-separator" />

          <div class="nsw-grid nsw-grid--spaced">
            <div class="nsw-col nsw-col-md-6 nsw-col-lg-4">
