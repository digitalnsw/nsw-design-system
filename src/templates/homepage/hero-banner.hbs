            <div class="nsw-col nsw-col-md-6 nsw-col-lg-4">
              {{>_content-block
                heading="Design System"
                copy="The NSW Government Design System contains reusable design, HTML and CSS UI components that help you create consistent, user-focused customer experiences."
                link="Start building"
                icon="<svg style='display:block;width:48px;height:48px;padding:3px;box-sizing:border-box;' xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48' fill='none'><path d='M27 39.5h-7.5v.25a4.75 4.75 0 0 0 4.75 4.75h.02a4.24 4.24 0 0 0 4.24-4.24V37.5H19' stroke='var(--nsw-pictogram-primary)' stroke-linejoin='round' stroke-miterlimit='10'/><line x1='11.5' y1='8.5' x2='13.5' y2='10.5' stroke='var(--nsw-pictogram-secondary)' stroke-linejoin='round' stroke-miterlimit='10'/><line x1='35.5' y1='10.5' x2='37.5' y2='8.5' stroke='var(--nsw-pictogram-secondary)' stroke-linejoin='round' stroke-miterlimit='10'/><line x1='24' y1='3' x2='24' y2='6' stroke='var(--nsw-pictogram-secondary)' stroke-linejoin='round' stroke-miterlimit='10'/><line x1='42' y1='20.5' x2='39' y2='20.5' stroke='var(--nsw-pictogram-secondary)' stroke-linejoin='round' stroke-miterlimit='10'/><polygon points='21.13 30.5 23.62 23.46 19.5 23.46 27.35 12.5 24.63 20.43 29 20.43 21.13 30.5' stroke='var(--nsw-pictogram-secondary)' stroke-linejoin='round' stroke-miterlimit='10'/><line x1='9' y1='20.5' x2='6' y2='20.5' stroke='var(--nsw-pictogram-secondary)' stroke-linejoin='round' stroke-miterlimit='10'/><path d='M29.52 31.09c3.59-1.97 6.02-5.8 5.98-10.19-.05-6.05-4.99-11.15-11.04-11.39C17.9 9.25 12.5 14.49 12.5 21c0 4.35 2.41 8.13 5.98 10.09.63.35 1.02 1.01 1.02 1.74v2.67h9v-2.68c0-.71.39-1.38 1.02-1.73Z' stroke='var(--nsw-pictogram-primary)' stroke-linejoin='round' stroke-miterlimit='10'/></svg>"
