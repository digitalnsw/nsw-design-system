  <section class="nsw-section nsw-section--off-white">
    <div class="nsw-container">
      <div class="nsw-layout">
        <div class="nsw-layout__main">
          <h2 class="nsw-section-title">Latest stories</h2>
          <p class="nsw-section-text">The latest in the digital space.</p>
          <div class="nsw-grid">
            <div class="nsw-col nsw-col-md-6 nsw-col-lg-4">
              {{>_card
                highlight=true
                heading= "Celebrating International Women’s Day"
                img="https://picsum.photos/id/838/400/200"
                tag="DCS Women in Technology Network"
                date="8 Mar 2021"
                date-machine="2021-03-08"
              }}
            </div>
            <div class="nsw-col nsw-col-md-6 nsw-col-lg-4">
              {{>_card
                highlight=true
                heading= "Cyber Security NSW - 2020 year in review"
                img="https://picsum.photos/id/3/400/200"
                tag="Cyber Security"
                date="21 Jan 2021"
                date-machine="2021-01-21"
              }}
            </div>
            <div class="nsw-col nsw-col-md-6 nsw-col-lg-4">
              {{>_card
                highlight=true
                heading= "Transforming transportnsw.info"
                img="https://picsum.photos/id/524/400/200"
                tag="Transport for NSW"
                date="28 Nov 2020"
                date-machine="2020-11-28"
              }}
