                icon="<svg style='display:block;width:48px;height:48px;padding:3px;box-sizing:border-box;' xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48' fill='none'><path d='M44.5 28V18.16a3.66 3.66 0 0 0-3.66-3.66H36.32a3.84 3.84 0 0 0-3.45 2.13' stroke='var(--nsw-pictogram-secondary)' stroke-linejoin='round'/><path d='M3.5 28V18.5a4 4 0 0 1 4-4H12a4 4 0 0 1 3.88 3L16.72 27A3.32 3.32 0 0 0 20 30h1.46a3 3 0 0 1 3 3v4' stroke='var(--nsw-pictogram-primary)' stroke-linejoin='round'/><line x1='9.5' y1='45' x2='9.5' y2='31' stroke='var(--nsw-pictogram-primary)' stroke-linejoin='round'/><line x1='5.5' y1='45' x2='5.5' y2='19' stroke='var(--nsw-pictogram-primary)' stroke-linejoin='round'/><line x1='13.5' y1='45' x2='13.5' y2='19' stroke='var(--nsw-pictogram-primary)' stroke-linejoin='round'/><path d='M13.54 9A3.5 3.5 0 1 0 10 12.5A3.5 3.5 0 0 0 13.54 9Z' stroke='var(--nsw-pictogram-primary)' stroke-linejoin='round'/><path d='M23.5 26A2.5 2.5 0 1 0 21 28.5A2.5 2.5 0 0 0 23.5 26Z' stroke='var(--nsw-pictogram-primary)' stroke-linejoin='round'/><path d='M33.5 20A2.5 2.5 0 1 0 31 22.5A2.5 2.5 0 0 0 33.5 20Z' stroke='var(--nsw-pictogram-secondary)' stroke-linejoin='round'/><line x1='38.5' y1='45' x2='38.5' y2='31' stroke='var(--nsw-pictogram-secondary)' stroke-linejoin='round'/><line x1='42.5' y1='45' x2='42.5' y2='19' stroke='var(--nsw-pictogram-secondary)' stroke-linejoin='round'/><path d='M41.51 9A3.5 3.5 0 1 0 38 12.5A3.5 3.5 0 0 0 41.51 9Z' stroke='var(--nsw-pictogram-secondary)' stroke-linejoin='round'/><path d='M27.5 34V27.76a3.26 3.26 0 0 1 3.26-3.26h.48a3.26 3.26 0 0 1 3.26 3.26V34' stroke='var(--nsw-pictogram-secondary)' stroke-linejoin='round'/><line x1='29.49' y1='45' x2='29.49' y2='33.95' stroke='var(--nsw-pictogram-secondary)' stroke-linejoin='round'/><line x1='32.51' y1='33.95' x2='32.51' y2='45' stroke='var(--nsw-pictogram-secondary)' stroke-linejoin='round'/><line x1='19.5' y1='45' x2='19.5' y2='37.02' stroke='var(--nsw-pictogram-primary)' stroke-linejo