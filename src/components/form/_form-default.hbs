<h3>Default</h3>

<h4>Text field</h4>
{{#>_docs-example separated=true}}
<div class="nsw-form">
  <div class="nsw-form__group">
    {{>_text-input
      id=(append "form-text-2" id-suffix)
      label="Name"
      helper-text="As it appears on your identity document"
    }}
  </div>
  <div class="nsw-form__group">
    {{>_textarea
      id=(append "form-textarea-2" id-suffix)
      label="Comment"
      helper-text="Maximum 500 characters"
    }}
  </div>
</div>
{{/_docs-example}}

<h4>Input group</h4>
{{#>_docs-example separated=true}}
<div class="nsw-form">
  <div class="nsw-form__group">
    {{>_input-group
      id=(append "form-input-group-1" id-suffix)
      label="Search"
    }}
  </div>
  <div class="nsw-form__group">
    {{>_input-group
      id=(append "form-input-group-icon-1" id-suffix)
      label="Search"
      icon="search"
    }}
  </div>
  <div class="nsw-form__group">
    {{>_input-group
      id=(append "form-input-group-icon-2" id-suffix)
      label="Search"
      icon="search"
      white="true"
    }}
  </div>
</div>
{{/_docs-example}}

<h4>Predictive list</h4>
{{#>_docs-example separated=true}}
<div class="nsw-form">
  <div class="nsw-form__group">
    <label class="nsw-form__label" for="form-predictive-text-1{{#if id-suffix}}-{{id-suffix}}{{/if}}">Suburb</label>
    <div class="nsw-form__predictive">
      <input class="nsw-form__input" type="text" id="form-predictive-text-1{{#if id-suffix}}-{{id-suffix}}{{/if}}" name="form-predictive-text-1{{#if id-suffix}}-{{id-suffix}}{{/if}}" value="Horn" aria-autocomplete="list" autocomplete="off">
      <ul class="nsw-form__predictive-list">
        <li><a href="#"><span>Horn</span>sby</a></li>
        <li><a href="#"><span>Horn</span>sby Heights</a></li>
        <li><a href="#"><span>Horn</span>ingsea Park</a></li>
      </ul>
    </div>
  </div>
  <br><br><br><br><br><br>
  <div class="nsw-form__group">
    <div class="nsw-form__predictive">
      {{>_input-group
        id=(append "form-predictive-group-1" id-suffix)
        label="Search"
        value="Tran"
        predictive=true
      }}
      <ul class="nsw-form__predictive-list">
        <li><a href="#"><span>Tran</span>sport</a></li>
        <li><a href="#">Road <span>Tran</span>sport</a></li>
        <li><a href="#">Public <span>Tran</span>sport</a></li>
      </ul>
    </div>
  </div>
  <br><br><br><br><br><br>
  <div class="nsw-form__group">
    <div class="nsw-form__predictive">
      {{>_input-group
        id=(append "form-predictive-group-icon-1" id-suffix)
        label="Search"
        value="Govern"
        icon="search"
        large=true
        predictive=true
      }}
      <ul class="nsw-form__predictive-list nsw-form__predictive-list--large">
        <li><a href="#"><span>Govern</span>ment</a></li>
        <li><a href="#"><span>Govern</span>ment payments</a></li>
        <li><a href="#"><span>Govern</span>ance</a></li>
      </ul>
    </div>
  </div>
  <br><br><br><br><br><br>
</div>
{{/_docs-example}}

<h4>Date</h4>
{{#>_docs-example separated=true}}
<div class="nsw-form">
  <div class="nsw-form__group">
    {{>_date
      id=(append "form-date-2" id-suffix)
      label="Date of birth"
      helper-text="For example 08 12 1990"
    }}
  </div>
</div>
{{/_docs-example}}

<h4>Select</h4>
{{#>_docs-example separated=true}}
<div class="nsw-form">
  <div class="nsw-form__group">
    {{>_select model.select
      id=(append "form-select-2" id-suffix)
      label="Region"
      helper-text="Your region of residence"
    }}
  </div>
</div>
{{/_docs-example}}

<h4>Checkbox</h4>
{{#>_docs-example separated=true}}
<div class="nsw-form">
  <div class="nsw-form__group">
    <fieldset class="nsw-form__fieldset">
      <legend>
        <span class="nsw-form__legend">Category</span>
        <span class="nsw-form__helper">Select all that applies to you</span>
      </legend>
      {{>_checkbox
        id=(append "form-checkbox-multi-2-a" id-suffix)
        name=(append "form-checkbox-multi-2" id-suffix)
        label="Customer Service"
      }}
      {{>_checkbox
        id=(append "form-checkbox-multi-2-b" id-suffix)
        name=(append "form-checkbox-multi-2" id-suffix)
        label="Communities and Justice"
      }}
    </fieldset>
  </div>
</div>
{{/_docs-example}}

<h4>Radio buttons</h4>
{{#>_docs-example separated=true}}
<div class="nsw-form">
  <div class="nsw-form__group">
    <fieldset class="nsw-form__fieldset">
      <legend>
        <span class="nsw-form__legend">Topic</span>
        <span class="nsw-form__helper">Select closest match</span>
      </legend>
      {{>_radio
        id=(append "form-radio-2-a" id-suffix)
        name=(append "form-radio-2" id-suffix)
        label="NSW Government"
      }}
      {{>_radio
        id=(append "form-radio-2-b" id-suffix)
        name=(append "form-radio-2" id-suffix)
        label="Business and Economy"
      }}
    </fieldset>
  </div>
</div>
{{/_docs-example}}