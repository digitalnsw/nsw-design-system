<h3>Success</h3>

<h4>Text Fields</h4>
{{#>_docs-example separated=true}}
<div class="nsw-form">
  <div class="nsw-form__group">
    {{>_text-input
      id=(append "form-text-4-" id-suffix)
      label="Name"
      helper-text="As it appears on your identity document"
      valid-text="This field has been validated"
    }}
  </div>
  <div class="nsw-form__group">
    {{>_textarea
      id=(append "form-textarea-4-" id-suffix)
      label="Comment"
      valid-text="This field has been validated"
      helper-text="Maximum 500 characters"
    }}
  </div>
</div>
{{/_docs-example}}

<h4>Date</h4>
{{#>_docs-example separated=true}}
<div class="nsw-form">
  <div class="nsw-form__group">
    {{>_date
      id=(append "form-date-4-" id-suffix)
      label="Date of birth"
      valid-text="This field has been validated"
      helper-text="For example 08 12 1990"
    }}
  </div>
</div>
{{/_docs-example}}

<h4>Select</h4>
{{#>_docs-example separated=true}}
<div class="nsw-form">
  <div class="nsw-form__group">
    {{>_select model.select
      id=(append "form-select-4-" id-suffix)
      label="Region"
      valid-text="This field has been validated"
      helper-text="Your region of residence"
    }}
  </div>
</div>
{{/_docs-example}}

<h4>Checkboxes</h4>
{{#>_docs-example separated=true}}
<div class="nsw-form">
  <div class="nsw-form__group">
    {{>_checkbox
      id=(append "form-checkbox-4-" id-suffix)
      name=(append "form-checkbox-4-" id-suffix)
      label="I agree to terms and conditions"
      valid-text="This field has been validated"
    }}
  </div>
  <div class="nsw-form__group">
    <fieldset class="nsw-form__fieldset">
      <legend>
        <span class="nsw-form__legend">Category</span>
        <span class="nsw-form__helper">Select all that applies to you</span>
        <span class="nsw-form__helper nsw-form__helper--valid"><span class="material-icons nsw-material-icons" focusable="false" aria-hidden="true">check_circle</span>This field has been validated</span>
      </legend>
      {{>_checkbox
        id=(append "form-checkbox-multi-4-a-" id-suffix)
        name=(append "form-checkbox-multi-4-" id-suffix)
        label="Customer Service"
      }}
      {{>_checkbox
        id=(append "form-checkbox-multi-4-b-" id-suffix)
        name=(append "form-checkbox-multi-4-" id-suffix)
        label="Communities and Justice"
      }}
    </fieldset>
  </div>
</div>
{{/_docs-example}}

<h4>Radio buttons</h4>
{{#>_docs-example separated=true}}
<div class="nsw-form">
  <div class="nsw-form__group">
    <fieldset class="nsw-form__fieldset">
      <legend>
        <span class="nsw-form__legend">Topic</span>
        <span class="nsw-form__helper">Select closest match</span>
        <span class="nsw-form__helper nsw-form__helper--valid"><span class="material-icons nsw-material-icons" focusable="false" aria-hidden="true">check_circle</span>This field has been validated</span>
      </legend>
      {{>_radio
        id=(append "form-radio-4-a-" id-suffix)
        name=(append "form-radio-4-" id-suffix)
        label="NSW Government"
      }}
      {{>_radio
        id=(append "form-radio-4-b-" id-suffix)
        name=(append "form-radio-4-" id-suffix)
        label="Business and Economy"
      }}
    </fieldset>
  </div>
</div>
{{/_docs-example}}