<h3>When no action is required</h3>
{{#>_docs-example separated=true}}
<div class="nsw-form">
  <div class="nsw-form__group">
    <label class="nsw-form__label" for="form-contextural-feedback-info-1">Vehicle registration</label>
    <span class="nsw-form__helper" id="form-contextural-feedback-info-1-helper-text">Enter a NSW plate number</span>
    <input class="nsw-form__input" type="text" id="form-contextural-feedback-info-1" name="form-contextural-feedback-info-1" aria-describedby="form-contextural-feedback-info-1-helper-text form-contextural-feedback-info-1-info-text" value="ABC123">
    <span class="nsw-form__helper nsw-form__helper--info" id="form-contextural-feedback-info-1-info-text"><span class="material-icons nsw-material-icons" focusable="false" aria-hidden="true">info</span><span><strong>Registration status update.</strong> This vehicle has an active safety recall. You can still proceed, but inspection may be required at renewal.</span></span>
  </div>
</div>
{{/_docs-example}}

<h3>When acton is required</h3>
{{#>_docs-example separated=true}}
<div class="nsw-form">
  <div class="nsw-form__group">
    <label class="nsw-form__label" for="form-contextural-feedback-1">Vehicle registration</label>
    <span class="nsw-form__helper" id="form-contextural-feedback-1-helper-text">Enter a NSW plate number</span>
    <input class="nsw-form__input has-warning" type="text" id="form-contextural-feedback-1" name="form-contextural-feedback-1" aria-describedby="form-contextural-feedback-1-helper-text form-contextural-feedback-1-warning-text" value="ABC123">
    <span class="nsw-form__helper nsw-form__helper--warning" id="form-contextural-feedback-1-warning-text"><span class="material-icons nsw-material-icons" focusable="false" aria-hidden="true">error</span><span><strong>Payment required.</strong> This vehicle has $723 in fines due. Payment is required before the registration can be renewed.</span></span>
  </div>
</div>
{{/_docs-example}}
