---
title: Hero search Demo & Code
page: true
code-page: true
model: json/hero-search.json
---

{{#*inline "hero-search-demo-examples"}}
  <h3>Using CSS for a background image</h3>
  {{#>_docs-example}}
  <div class="nsw-section nsw-section--image" style="background-image: url(https://picsum.photos/id/199/2000/1250);">
    {{>_hero-search model id=searchId1 button="icon"}}
  </div>
  {{/_docs-example}}

  <h3>Using HTML for a background image</h3>
  {{#>_docs-example}}
  <div class="nsw-section nsw-section--image-html">
    {{>_hero-search model id=searchId2 button="text" label="true"}}
    <img src="https://picsum.photos/id/204/2000/1250" alt="Background image"/>
  </div>
  {{/_docs-example}}
{{/inline}}

{{#>_theme}}
  {{#>_layout-container}}
    <h1>Hero search Demo &amp; Code</h1>
    {{> hero-search-demo-examples searchId1="default-1" searchId2="default-2"}}
  {{/_layout-container}}

  {{#>_layout-container brand-light="true"}}
    {{> hero-search-demo-examples searchId1="brand-light-1" searchId2="brand-light-2"}}
  {{/_layout-container}}

  {{#>_layout-container brand-dark="true" invert="true"}}
    {{> hero-search-demo-examples searchId1="inverted-1" searchId2="inverted-2"}}
  {{/_layout-container}}
{{/_theme}}
