{{#*inline "popover-demo-examples"}}
<h2 class="nsw-p-top-0">Position</h2>
<p>Places the Popover relative to the trigger element.</p>

<h3 class="h4 nsw-p-0">Top</h3>
{{#>_docs-example separated="true"}}
<div class="nsw-list nsw-list--8">
  {{#each model.top}}
{{>_popover style="dark-outline" icon="info" text=this id=@key id-suffix=../id-suffix position=@key gap="10"}}
  {{/each}}
</div>
{{/_docs-example}}

