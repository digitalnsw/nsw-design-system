---
title: 'Tooltip: Demo & code'
width: narrow
page: true
code-page: true
---

{{#*inline "tooltip-demo-examples"}}
<div class="nsw-tabs js-tabs">
  <ul class="nsw-tabs__list">
    <li><a href="#{{append 'light' id-suffix}}" class="js-tabs-fixed">Dark</a></li>
    <li><a href="#{{append 'dark' id-suffix}}" class="js-tabs-fixed">Light</a></li>
  </ul>

  <section id="{{append 'light' id-suffix}}"  class="nsw-tabs__content nsw-tabs__content--side-flush">
    
    <h3 class="nsw-m-bottom-sm">Tooltip</h3>

    {{#>_docs-example}}
{{>_tooltip dark-tooltip=true}}
    {{/_docs-example}}

    <h3 class="nsw-m-bottom-sm">Toggletip</h3>

    {{#>_docs-example}}
{{>_toggletip dark-toggletip=true id=(append "dark" id-suffix)}}
    {{/_docs-example}}

  </section>
  
  <section id="{{append 'dark' id-suffix}}" class="nsw-section--invert nsw-tabs__content nsw-tabs__content--side-flush">

    <h3 class="nsw-text--dark nsw-m-bottom-sm">Tooltip</h3>

    {{#>_docs-example dark=true}}
{{>_tooltip light-tooltip=true}}
    {{/_docs-example}}

    <h3 class="nsw-text--dark nsw-m-bottom-sm">Toggletip</h3>

    {{#>_docs-example dark=true}}
{{>_toggletip light-toggletip=true id=(append "light" id-suffix)}}
    {{/_docs-example}}

  </section>
</div>
{{/inline}}

{{#>_theme}}
  {{#>_layout-container}}
    <h1>{{title}}</h1>
    {{> tooltip-demo-examples id-suffix="-default"}}
  {{/_layout-container}}

  {{#>_layout-container brand-light="true"}}
    {{> tooltip-demo-examples id-suffix="-brand-light"}}
  {{/_layout-container}}

  {{#>_layout-container brand-dark="true" invert="true"}}
    {{> tooltip-demo-examples id-suffix="-inverted"}}
  {{/_layout-container}}
{{/_theme}}
