---
title: 'Steps: Demo & code'
width: narrow
page: true
code-page: true
---

{{#*inline "steps-demo-examples"}}
<h3>Outline</h3>
<div class="nsw-tabs js-tabs">
  <ul class="nsw-tabs__list">
    <li><a href="#{{append 'outline-brand-accent' id-suffix}}" class="js-tabs-fixed">Brand Accent</a></li>
    <li><a href="#{{append 'outline-brand-dark' id-suffix}}" class="js-tabs-fixed">Brand Dark</a></li>
    <li><a href="#{{append 'outline-brand-light' id-suffix}}" class="js-tabs-fixed">Brand Light</a></li>
    <li><a href="#{{append 'outline-brand-supplementary' id-suffix}}" class="js-tabs-fixed">Brand Supplementary</a></li>
    <li><a href="#{{append 'outline-progress' id-suffix}}" class="js-tabs-fixed">Progress</a></li>
  </ul>
  <section id="{{append 'outline-brand-accent' id-suffix}}" class="nsw-tabs__content nsw-tabs__content--side-flush">
{{#>_docs-example}}
{{>_steps}}
{{/_docs-example}}
  </section>
  <section id="{{append 'outline-brand-dark' id-suffix}}"  class="nsw-tabs__content nsw-tabs__content--side-flush">
{{#>_docs-example light="true"}}
{{>_steps theme="dark"}}
{{/_docs-example}}
  </section>
  <section id="{{append 'outline-brand-light' id-suffix}}"  class="nsw-tabs__content nsw-tabs__content--side-flush">
{{#>_docs-example dark="true" invert="true"}}
{{>_steps theme="light"}}
{{/_docs-example}}
  </section>
  <section id="{{append 'outline-brand-supplementary' id-suffix}}"  class="nsw-tabs__content nsw-tabs__content--side-flush">
{{#>_docs-example}}
{{>_steps theme="supplementary"}}
{{/_docs-example}}
  </section>
  <section id="{{append 'outline-progress' id-suffix}}" class="nsw-tabs__content nsw-tabs__content--side-flush">
{{#>_docs-example}}
{{>_steps progress="true"}}
{{/_docs-example}}
  </section>
</div>

