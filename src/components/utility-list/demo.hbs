---
title: 'Utility list: Demo & code'
width: narrow
page: true
code-page: true
model: ../../components/utility-list/json/utility-list.json
---

{{#*inline "utility-list-demo-examples"}}
{{#each model}}
  <h3>{{@key}}</h3>
  {{#each this}}
    {{#>_docs-example separated=true}}
{{>_utility-list pdf="nsw-docs__main" id=id id-suffix=../../../id-suffix}}
    {{/_docs-example}}
  {{/each}}
{{/each}}
{{/inline}}

{{#>_theme}}
  {{#>_layout-container}}
    <h1>{{title}}</h1>
    {{> utility-list-demo-examples id-suffix="-default"}}
  {{/_layout-container}}

  {{#>_layout-container brand-light="true"}}
    {{> utility-list-demo-examples id-suffix="-brand-light"}}
  {{/_layout-container}}

  {{#>_layout-container brand-dark="true" invert="true"}}
    {{> utility-list-demo-examples id-suffix="-inverted"}}
  {{/_layout-container}}
{{/_theme}}

