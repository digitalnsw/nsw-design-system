width: narrow
page: true
code-page: true
model:
  dialog-transactional: json/dialog-transactional.json
  dialog-single-cta: json/dialog-single-cta.json
  dialog-danger: json/dialog-danger.json
  dialog-dismissible: json/dialog-dismissible.json
