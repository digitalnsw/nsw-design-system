    {{> dialog-demo-examples model=model transactionalId="demo-transactional" singleId="demo-single-cta" dangerId="demo-danger" dismissibleId="demo-dismissible"}}
  {{/_layout-container}}

  {{#>_layout-container brand-light="true"}}
    {{> dialog-demo-examples model=model transactionalId="demo-light-transactional" singleId="demo-light-single-cta" dangerId="demo-light-danger" dismissibleId="demo-light-dismissible"}}
  {{/_layout-container}}

  {{#>_layout-container brand-dark="true" invert="true"}}
    {{> dialog-demo-examples model=model transactionalId="demo-dark-transactional" singleId="demo-dark-single-cta" dangerId="demo-dark-danger" dismissibleId="demo-dark-dismissible"}}
  {{/_layout-container}}
{{/_theme}}
