{{#*inline "dialog-demo-examples"}}
<h3>Transactional</h3>
{{#>_docs-example}}{{>_dialog model.dialog-transactional id=transactionalId}}{{/_docs-example}}

<h3>Single call to action</h3>
{{#>_docs-example}}{{>_dialog model.dialog-single-cta id=singleId}}{{/_docs-example}}

<h3>Danger</h3>
{{#>_docs-example}}{{>_dialog model.dialog-danger id=dangerId}}{{/_docs-example}}

<h3>Dismissible</h3>
{{#>_docs-example}}{{>_dialog model.dialog-dismissible id=dismissibleId}}{{/_docs-example}}
{{/inline}}

{{#>_theme}}
  {{#>_layout-container}}
