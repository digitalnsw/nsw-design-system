  <h3>Toggle controls (progressively enhanced)</h3>
  {{#>_docs-example}}{{>_accordion toggle type="details" id-suffix=id-suffix}}{{/_docs-example}}

  <hr class="nsw-m-top-lg"/>

  <h2>Legacy variation (JS-core dependent)</h2>

  <h3>Accordion with expand/collapse all</h3>
  {{#>_docs-example}}{{>_accordion legacy-toggle type="js" id-suffix=id-suffix}}{{/_docs-example}}

  <h3>Simple accordion</h3>
  {{#>_docs-example}}{{>_accordion legacy-regular type="js" id-suffix=id-suffix}}{{/_docs-example}}
{{/inline}}

{{#>_theme}}
  {{#>_layout-container}}
